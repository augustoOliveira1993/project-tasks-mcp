# Execucao local com Node.js 24. Caminhos relativos partem desta pasta.
MONGODB_URI=mongodb://localhost:27018/project_tasks?replicaSet=rs0
PORT=3443
LEASE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3443

# Endereco usado pela CLI administrativa.
SERVICE_URL=http://localhost:3443
# Opcional: apenas em ambiente administrativo privado; nunca no front/back.
# ADMIN_TOKEN=token_humano
# bearer (padrão) ou trusted_local; trusted_local usa X-Project-Tasks-Email.
MCP_AUTH_MODE=trusted_local
