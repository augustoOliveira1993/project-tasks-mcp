# Configuracao local do MCP com Node.js 24. Copie para .env e ajuste os valores.
# Obrigatorias para iniciar o servidor: MONGODB_URI, PORT, LEASE_MINUTES,
# SERVICE_URL e MCP_AUTH_MODE.
# URI do MongoDB. O servidor exige replica set; no desenvolvimento local, yarn dev
# inicia uma instancia dedicada na porta informada (27018 por padrao).
MONGODB_URI=mongodb://localhost:27018/project_tasks?replicaSet=rs0
# Porta HTTP do MCP e do painel servido em /admin.
PORT=3443
# Prazo do lease de uma tarefa em execucao, em minutos; heartbeats renovam o prazo.
LEASE_MINUTES=30
# URL base HTTP(S) usada pela CLI ao chamar endpoints administrativos.
SERVICE_URL=http://localhost:3443
# Modo de autenticacao do servidor: bearer exige token Bearer; trusted_local identifica
# chamadas pelo cabecalho X-Project-Tasks-Email e deve ficar restrito a rede confiavel.
MCP_AUTH_MODE=trusted_local

# Variaveis opcionais:
# Origens web autorizadas por CORS, separadas por virgula. Deixe vazio se nao precisar.
ALLOWED_ORIGINS=http://localhost:3443
# Nivel minimo dos logs Winston (por exemplo: error, warn, info, debug). Padrao: info.
# LOG_LEVEL=info
# Caminhos do certificado e da chave TLS. Defina os dois para habilitar HTTPS.
# TLS_CERT_PATH=/caminho/para/certificado.pem
# TLS_KEY_PATH=/caminho/para/chave.pem
# Caminho do executavel mongod. Usado por yarn dev e yarn mongo:local;
# no Windows, o projeto tenta localizar a instalacao automaticamente se omitido.
# MONGOD_PATH=C:/Program Files/MongoDB/Server/8.2/bin/mongod.exe
# Rotulo de ambiente nos logs. O padrao e local; PM2 define production com --env production.
# NODE_ENV=production
# Token humano ativo (64 caracteres hexadecimais) para comandos administrativos da CLI.
# Mantenha secreto e nao o inclua no frontend nem no Git.
# ADMIN_TOKEN=
