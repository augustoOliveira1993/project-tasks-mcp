{
  "name": "project-tasks-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-environment.mjs",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "dev": "nodemon --signal SIGTERM --watch src --ext ts --exec node --env-file-if-exists=.env --import tsx src/dev.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "frontend:check": "tsc --noEmit -p frontend/tsconfig.json",
    "build:mcp": "tsc -p tsconfig.build.json",
    "build:frontend": "yarn frontend:check && yarn frontend:build",
    "build": "yarn build:mcp && yarn build:frontend",
    "start:prod": "node --env-file-if-exists=.env dist/src/prod.js",
    "deploy:pm2": "yarn build && pm2 restart project-tasks-mcp",
    "cli": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "migrate:task-search-index": "node --env-file-if-exists=.env --import tsx scripts/migrate-task-text-index.ts",
    "seed:conversation-types": "node --env-file-if-exists=.env --import tsx scripts/seed-conversation-types.ts",
    "test:flow": "tsx --test test/flow.test.ts",
    "mongo:local": "node --env-file-if-exists=.env --import tsx src/local-mongo.ts",
    "test:clients": "node --import tsx --test test/clients.test.ts",
    "runner": "node --import tsx src/runner/main.ts",
    "bridge": "node --env-file-if-exists=.env --import tsx src/bridge/main.ts",
    "test:realtime": "node --import tsx --test test/realtime.test.ts test/runner.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.269",
    "@anthropic-ai/sdk": "0.125.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "^5.1.0",
    "mammoth": "1.13.0",
    "mongoose": "^9.0.0",
    "tsx": "^4.20.0",
    "winston": "^3.19.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "^20.14.5",
    "lucide-react": "^1.71.0",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.1.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
